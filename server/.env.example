NODE_ENV=development
TRUST_PROXY_HOPS=1
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/hrms
# Vercel MongoDB Atlas integration may provide MONGODB_URI instead.
# MONGODB_URI=
REDIS_URL=redis://127.0.0.1:6379
REDIS_RATE_LIMIT_ENABLED=false
AUTH_RATE_LIMIT_MAX=50
API_RATE_LIMIT_MAX=1200
HR_AUTOMATION_ENABLED=true

JWT_ACCESS_SECRET=replace_with_64_char_hex_secret
JWT_REFRESH_SECRET=replace_with_64_char_hex_secret
ACCESS_TOKEN_COOKIE_MINUTES=60
REFRESH_TOKEN_EXPIRES_DAYS=30
ENCRYPTION_MASTER_KEY=replace_with_64_char_hex_key_32_bytes

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
SOCKET_PATH=/socket.io
COOKIE_SAME_SITE=strict

# ZKTeco MB20-VL biometric attendance (server must be on the device LAN/VPN)
ZKTECO_ENABLED=false
ZKTECO_IP=
ZKTECO_PORT=4370
ZKTECO_COMM_KEY=0
ZKTECO_RECONCILE_INTERVAL=300000
ZKTECO_RECONCILE_LOOKBACK_DAYS=7
ZKTECO_NATIVE_REALTIME=true
ZKTECO_RECONNECT_DELAY=2000
ZKTECO_TIMEOUT=10000
ZKTECO_TIMEZONE=Asia/Karachi
ZKTECO_COMPANY_ID=

# Set to ses to route all outgoing mail through AWS SES, ignoring company SMTP overrides.
# Use the regional SES SMTP endpoint and a sender verified in that region.
SMTP_PROVIDER=
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional GeoIP endpoint for approximate privileged-login alert locations.
# Must be HTTPS, contain {ip}, and return JSON with city, region/region_name,
# and/or country/country_name fields. Public IPs are not sent anywhere unless configured.
IP_GEOLOCATION_URL=
